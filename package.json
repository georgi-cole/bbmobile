{
  "name": "bbmobile",
  "version": "1.0.0",
  "description": "Big Brother Mobile Game",
  "type": "module",
  "scripts": {
    "validate:minigames": "node scripts/validate-minigame-keys.mjs",
    "validate:legacy-map": "node scripts/validate-legacy-map.mjs",
    "audit:minigames": "node scripts/audit-minigame-keys.mjs",
    "test:minigames": "npm run validate:minigames && npm run validate:legacy-map && node scripts/test-runtime-validation.mjs",
    "test:runtime": "node scripts/test-runtime-validation.mjs",
    "test:e2e": "node scripts/test-e2e-competitions.mjs",
    "test:jurors": "node scripts/test-jurors-return-challenge.mjs",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:social": "playwright test test_game_progression_social_automated.spec.js",
    "test:all": "npm run test:minigames && npm run test:e2e",
    "build:progression": "cd src/progression && tsc",
    "typecheck:progression": "cd src/progression && tsc --noEmit",
    "playwright:install": "playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/georgi-cole/bbmobile.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^5.3.3"
  }
}
