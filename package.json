{
  "name": "bbmobile",
  "version": "1.0.0",
  "description": "Big Brother Mobile Game",
  "type": "module",
  "scripts": {
    "validate:minigames": "node scripts/validate-minigame-keys.mjs",
    "validate:legacy-map": "node scripts/validate-legacy-map.mjs",
    "audit:minigames": "node scripts/audit-minigame-keys.mjs",
    "audit:bg-assets": "node scripts/audit-background-assets.js",
    "test:minigames": "npm run validate:minigames && npm run validate:legacy-map && node scripts/test-runtime-validation.mjs",
    "test:runtime": "node scripts/test-runtime-validation.mjs",
    "test:runtime-helpers": "node scripts/test-runtime-helpers.mjs",
    "test:e2e": "node scripts/test-e2e-competitions.mjs",
    "test:jurors": "node scripts/test-jurors-return-challenge.mjs",
    "test:social": "node verify_social_phase_requirements.mjs",
    "test:veto-twists": "node tests/verify_veto_twists.mjs",
    "test:pov-carousel": "node tests/verify_pov_carousel.mjs",
    "test:pause-integration": "node tests/verify_pause_integration.mjs",
    "test:background-theme": "node scripts/test-background-theme.mjs",
    "test:all": "npm run test:minigames && npm run test:runtime-helpers && npm run test:e2e && npm run test:social && npm run test:pov-carousel && npm run test:pause-integration && npm run test:background-theme",
    "build:progression": "cd src/progression && tsc",
    "typecheck:progression": "cd src/progression && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/georgi-cole/bbmobile.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "jsdom": "^27.2.0"
  }
}
